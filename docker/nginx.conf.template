# nx-as 容器内 nginx 模板（entrypoint 用 envsubst 渲染）
# 路径契约：nx-as 自有功能全部收在 /_nxas/ 特殊前缀；其余一切路径 100% 原样直代
# pi-web（它的 /login、/api/*、/_next/* 与直跑根路径完全一致，零改动零感知）。

server {
    listen ${NXAS_LISTEN_PORT};
    server_name _;
    absolute_redirect off;
${NXAS_TLS_BLOCK}

    # ── nx-as 登录页（浏览器未登录时 302 的目的地）──
    location = /_nxas/login {
        proxy_pass http://127.0.0.1:7801/_nxas/login;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # ── nx-as 全部自有端点（鉴权决策/登录/管理面 API/手机 API）──
    # 手机 API /m/v1/*：自带 Bearer 鉴权（pair 免鉴权），不经 auth_request
    location /_nxas/ {
        proxy_pass http://127.0.0.1:7801/_nxas/;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
    location /m/v1/ {
        proxy_pass http://127.0.0.1:7801/_nxas/m/v1/;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;          # SSE 事件流不缓冲
        proxy_read_timeout 1h;
    }

    # /m/v1/ 上面已完成 nx-as 鉴权（handleGateway）；这里给 pi-web 上游注入机机 Basic
    location /_nxas/m/v1/ {
        proxy_pass http://127.0.0.1:30141/api/;
        proxy_set_header Authorization "Basic ${NXAS_MACHINE_B64}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;          # SSE 事件流不缓冲
        proxy_read_timeout 1h;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # ── 其余一切：auth_request 拦截 + 100% 原样直代 pi-web ──
    location / {
        auth_request /_nxas_auth;
        auth_request_set $nxas_device $upstream_http_x_device_id;
        error_page 401 = @nxas_login;
        proxy_pass http://127.0.0.1:30141;
        proxy_set_header Host $http_host;            # 原样 Host（含端口）——pi-web 的 Origin 同源校验逐字节比对
        proxy_set_header X-Forwarded-Proto $scheme;  # 配合 isProxyRewrittenSameOrigin 放行
        proxy_set_header Authorization "Basic ${NXAS_MACHINE_B64}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;          # SSE 不缓冲
        proxy_read_timeout 1h;        # SSE 长连
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header X-Nxas-Device $nxas_device always;
    }

    # ── 委托端点：每请求一个 loopback 子请求 ──
    location = /_nxas_auth {
        internal;
        proxy_pass http://127.0.0.1:7801/_nxas/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Accept $http_accept;
        proxy_set_header X-Original-Uri $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # 未登录的浏览器页面请求 → 跳 nx-as 登录页（登录后回原路径）
    location @nxas_login {
        return 302 /_nxas/login?next=$request_uri;
    }
}
