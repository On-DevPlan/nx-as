# nx-as 容器内 nginx 模板（entrypoint 用 envsubst 渲染 NXAS_MACHINE_B64 / NXAS_LISTEN_PORT / NXAS_TLS_BLOCK）
# 默认 HTTP；HTTPS 由外部证书导入后 entrypoint 注入 NXAS_TLS_BLOCK 启用

server {
    listen ${NXAS_LISTEN_PORT};
    server_name _;
${NXAS_TLS_BLOCK}

    # ── 网关本地端点：配对与短票签发（自带校验，不走 auth_request）──
    location = /m/v1/pair {
        proxy_pass http://127.0.0.1:7801;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location ~ ^/m/v1/sessions/[^/]+/ticket$ {
        proxy_pass http://127.0.0.1:7801;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # ── 数据路径：委托鉴权 + 直代 pi-web（SSE 直通）──
    location /m/v1/ {
        auth_request /_nxas_auth;
        auth_request_set $nxas_device $upstream_http_x_device_id;
        proxy_pass http://127.0.0.1:30141/api/;
        proxy_set_header Authorization "Basic ${NXAS_MACHINE_B64}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;          # SSE 关键：不缓冲
        proxy_read_timeout 1h;        # SSE 长连
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header X-Nxas-Device $nxas_device always;
    }

    # ── pi-web 完整页面（受同一 auth_request 拦截；device token 鉴权后可见）──
    # EventSource/SSE 与 WebSocket 升级头均透传； pi-web 的 API 前缀 /api/ 原样保留
    location /pi/ {
        auth_request /_nxas_auth;
        auth_request_set $nxas_device $upstream_http_x_device_id;
        proxy_pass http://127.0.0.1:30141/;
        proxy_set_header Authorization "Basic ${NXAS_MACHINE_B64}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;          # SSE 不缓冲
        proxy_read_timeout 1h;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Nxas-Device $nxas_device;
        # 浏览器渲染需要的响应头透传
        add_header X-Nxas-Device $nxas_device always;
    }

    # pi-web 的静态资源路径同样拦截（/_next/* 等经 /pi/ 前缀天然命中上面 location）

    # ── 委托端点：每请求一个 loopback 子请求 ──
    location = /_nxas_auth {
        internal;
        proxy_pass http://127.0.0.1:7801/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-Uri $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # ── 管理面板（管理密钥在 nx-as 侧校验）──
    location / {
        proxy_pass http://127.0.0.1:7801;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 1h;
    }
}