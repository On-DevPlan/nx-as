# nx-as 基础镜像 nginx 模板（entrypoint 渲染；v0.6）
#
# 设计原则：nx-as 只占 ONE 命名空间 /_nxas/*，其余路径 100% 留给主进程
# （NXAS_TARGET_CMD）。登录成功后主程序零感知——路径、头部、cookie 全部原样。
#
# 路径契约：
#   /_nxas/*                  → nx-as 自有（登录页/登录 API/鉴权决策/管理面/手机 API/bootstrap）
#   NXAS_PROTECT 命中的路径    → auth_request 鉴权后直代主进程
#   其余                       → （默认）鉴权后直代主进程；PROTECT 非 /* 时公开直通
#
# envsubst 变量（entrypoint export）：
#   NXAS_LISTEN_PORT / NXAS_API_PORT / NXAS_TARGET_PORT / NXAS_TLS_BLOCK /
#   NXAS_PROTECT_BLOCKS / NXAS_CATCHALL_BODY
server {
    listen ${NXAS_LISTEN_PORT};
    server_name _;
    absolute_redirect off;
${NXAS_TLS_BLOCK}

    # ── nx-as 唯一命名空间：登录/鉴权/管理面/手机 API ──
    location /_nxas/ {
        proxy_pass http://127.0.0.1:${NXAS_API_PORT}/_nxas/;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # ── 面板 SPA 静态资源（/_nxas/panel 页面引用 /assets/* 与根级图片/图标；
    #    JS/CSS/图片无敏感数据，数据面由 TokenGate 管理密钥 + /_nxas/api/* 保护）──
    location /assets/ {
        proxy_pass http://127.0.0.1:${NXAS_API_PORT}/assets/;
    }
    location ~ ^/(favicon\.ico|favicon-\d+\.png|logo(-rounded)?\.png|manifest\.webmanifest)$ {
        proxy_pass http://127.0.0.1:${NXAS_API_PORT};
    }

    # ── 委托端点（internal：外部不可达，仅 auth_request 使用）──
    location = /_nxas/auth-internal {
        internal;
        proxy_pass http://127.0.0.1:${NXAS_API_PORT}/_nxas/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Accept $http_accept;
        proxy_set_header X-Original-Uri $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # 未登录的浏览器页面请求 → 跳 nx-as 登录页（登录后经 bootstrap 回到原路径）
    location @nxas_login {
        return 302 /_nxas/login?next=$request_uri;
    }
${NXAS_PROTECT_BLOCKS}
    # ── catch-all：主进程（NXAS_TARGET_CMD）──
    # NXAS_PROTECT=/* → 带鉴权；否则公开直通（受保护路径已在上面单列）
    location / {
${NXAS_CATCHALL_BODY}
    }
}
